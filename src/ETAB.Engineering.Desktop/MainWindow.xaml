<Window x:Class="ETAB.Engineering.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="ETAB Engineering"
        Width="1500"
        Height="940"
        MinWidth="1120"
        MinHeight="720"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowBackground}"
        Closing="Window_Closing"
        Loaded="Window_Loaded">
  <Grid Background="{StaticResource WindowBackground}">
    <wv2:WebView2 x:Name="EditorWebView"
                  Visibility="Hidden" />
    <Border x:Name="LoadingPanel"
            Background="{StaticResource WindowBackground}">
      <StackPanel HorizontalAlignment="Center"
                  VerticalAlignment="Center">
        <Border Width="58"
                Height="58"
                CornerRadius="14"
                Background="#5DD9CE"
                Margin="0,0,0,20">
          <TextBlock Text="ET"
                     HorizontalAlignment="Center"
                     VerticalAlignment="Center"
                     Foreground="#0C1516"
                     FontSize="21"
                     FontWeight="Bold" />
        </Border>
        <TextBlock Text="ETAB Engineering"
                   HorizontalAlignment="Center"
                   Foreground="#F4FAFA"
                   FontSize="24"
                   FontWeight="SemiBold" />
        <TextBlock x:Name="LoadingMessage"
                   Text="Starting the local engineering workspace…"
                   HorizontalAlignment="Center"
                   Margin="0,10,0,22"
                   Foreground="#91AAAA"
                   FontSize="13" />
        <ProgressBar Width="260"
                     Height="4"
                     IsIndeterminate="True"
                     Foreground="#5DD9CE"
                     Background="#1A292A" />
      </StackPanel>
    </Border>
  </Grid>
</Window>
